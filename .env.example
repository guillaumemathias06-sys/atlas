# ATLAS — variables d'environnement
# Copier en .env et adapter. Ne jamais committer .env.

# Base de données locale (SQLite, zéro-config). Pour la prod, remplacer par
# une URL PostgreSQL et changer `provider` dans prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# --- Providers de vols réels (Phase 5) — optionnel, laisser vide pour rester en mode MOCK ---
# Duffel (recommandé : sandbox gratuite, données réelles)
DUFFEL_API_KEY=
# Amadeus for Developers (alternative)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# Kiwi/Tequila (alternative)
KIWI_API_KEY=

# --- Météo / saisonnalité réelle (Phase 5) — optionnel ---
OPENWEATHER_API_KEY=

# --- Canaux de notification (Phase 4+) — optionnel ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
ATLAS_ALERT_EMAIL_TO=

# --- Sécurité ---
# Clé utilisée pour signer/valider les actions sensibles (achat, purchase policy).
ATLAS_ADMIN_SECRET=change-me-locally
