# ATLAS — variables d'environnement
# Copier en .env et adapter. Ne jamais committer .env.

# Base de données locale (SQLite, zéro-config). Pour la prod, remplacer par
# une URL PostgreSQL et changer `provider` dans prisma/schema.prisma.
# Voir docs/deployment.md pour la procédure complète de mise en ligne.
DATABASE_URL="file:./dev.db"

# --- Providers de vols réels (Phase 5) — optionnel, laisser vide pour rester en mode MOCK ---
# Duffel (recommandé : sandbox gratuite, données réelles)
DUFFEL_API_KEY=
# Amadeus for Developers (alternative)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# Kiwi/Tequila (alternative)
KIWI_API_KEY=

# --- Météo / saisonnalité réelle (Phase 5) — optionnel ---
OPENWEATHER_API_KEY=

# --- Canaux de notification (Phase 4+) — optionnel ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
ATLAS_ALERT_EMAIL_TO=

# --- Sécurité (mise en ligne) ---
# Protège TOUT le site derrière un mot de passe unique (outil personnel mono-utilisateur).
# Laisser vide en local (accès libre, pratique pour développer/tester). À définir
# impérativement avant toute mise en ligne publique. Voir docs/deployment.md.
SITE_PASSWORD=


# Protège POST/GET /api/engine/scan contre un déclenchement par un tiers une fois le site
# public. Laisser vide en local (l'endpoint reste ouvert pour rester simple à tester).
# En production : générer une valeur aléatoire (ex. `openssl rand -hex 32`) et la
# renseigner aussi dans la config Vercel Cron (Vercel l'envoie automatiquement en
# Authorization: Bearer <CRON_SECRET> dès qu'elle est définie comme variable
# d'environnement du projet). Voir docs/deployment.md.
CRON_SECRET=
